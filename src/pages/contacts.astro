---
// src/pages/contacts.astro
// Контакты компании

import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumb from '@/components/common/Breadcrumb.astro';
import TrustBadges from '@/components/common/TrustBadges.astro';
import Container from '@/components/layout/Container.astro';
import ContactForm from '@/components/forms/ContactForm.astro';
import { COMPANY_INFO } from '@/lib/constants';
---

<BaseLayout 
  title="Контакты — SARPRO"
  description="Свяжитесь с SARPRO. Адрес, телефон, email и форма обратной связи."
>
  <Container>
    <Breadcrumb items={[
      { label: 'Главная', url: '/' },
      { label: 'Контакты', url: '/contacts' }
    ]} />

    <div class="py-12 md:py-16">
      <h1 class="text-4xl md:text-5xl font-bold mb-4">Контакты</h1>
      <p class="text-lg text-gray-600 mb-12">
        Свяжитесь с нами любым удобным способом. Мы ответим на ваши вопросы в течение 24 часов.
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-12 md:gap-16">
        <!-- Контактная информация -->
        <div>
          <h2 class="text-2xl font-bold mb-8">Информация</h2>

          <div class="space-y-8">
            <!-- Телефоны -->
            <div>
              <h3 class="font-bold text-lg mb-3">Телефон</h3>
              <div class="space-y-2">
                <p>
                  <strong>Саратов:</strong><br/>
                  <a href={`tel:${COMPANY_INFO.phoneMain.replace(/\D/g, '')}`} class="text-primary-600 hover:underline text-lg">
                    {COMPANY_INFO.phoneMain}
                  </a>
                </p>
              </div>
            </div>

            <!-- Компания -->
            <div>
              <h3 class="font-bold text-lg mb-3">Компания</h3>
              <p class="text-gray-700">
                {COMPANY_INFO.name}
              </p>
            </div>

            <!-- Email -->
            <div>
              <h3 class="font-bold text-lg mb-3">Email</h3>
              <a href={`mailto:${COMPANY_INFO.email}`} class="text-primary-600 hover:underline text-lg">
                {COMPANY_INFO.email}
              </a>
            </div>

            <!-- Часы работы -->
            <div>
              <h3 class="font-bold text-lg mb-3">Часы работы</h3>
              <p class="text-gray-700">
                Пн—Пт: 8:00—19:00<br/>
                Сб—Вс: 9:00—17:00
              </p>
            </div>
          </div>
        </div>

        <!-- Форма -->
        <div>
          <h2 class="text-2xl font-bold mb-8">Оставить заявку</h2>
          <ContactForm />
        </div>
      </div>
    </div>
  </Container>

  <TrustBadges />
</BaseLayout>
