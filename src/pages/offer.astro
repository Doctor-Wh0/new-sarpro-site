---
// src/pages/offer.astro
// Условия продажи / Оферта

import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumb from '@/components/common/Breadcrumb.astro';
import Container from '@/components/layout/Container.astro';
import { COMPANY_INFO } from '@/lib/constants';
import { generateWebPageSchema } from '@/lib/schema';

const baseUrl = import.meta.env.SITE || 'https://saratov-pro.github.io';
const title = 'Условия продажи — SARPRO';
const description = 'Условия продажи и генеральная оферта SARPRO.';
---

<BaseLayout 
  title={title}
  description={description}
  schema={generateWebPageSchema(title, description, `${baseUrl}/offer`)}
>
  <Container>
    <Breadcrumb items={[
      { label: 'Главная', url: '/' },
      { label: 'Условия продажи', url: '/offer' }
    ]} />

    <div class="py-12 md:py-16 max-w-4xl">
      <h1 class="text-4xl md:text-5xl font-bold mb-4 text-gray-900">Условия продажи и оферта</h1>
      <p class="text-sm text-gray-600 mb-12">Последнее обновление: апрель 2026</p>

      <div class="space-y-8 text-gray-700 leading-relaxed">
        {/* Раздел 1 */}
        <section class="space-y-3">
          <h2 class="text-2xl md:text-3xl font-bold text-gray-900">1. Общие условия</h2>
          <p class="text-base">
            Данная оферта является открытым предложением {COMPANY_INFO.name} (далее — «Продавец») на заключение договора купли-продажи товаров, представленных на сайте, на предложенных ниже условиях.
          </p>
        </section>

        {/* Раздел 2 */}
        <section class="space-y-3">
          <h2 class="text-2xl md:text-3xl font-bold text-gray-900">2. Акцепт оферты</h2>
          <ul class="space-y-2 ml-6 list-disc list-outside">
            <li>Размещение заказа на сайте является акцептом оферты</li>
            <li>Договор считается заключённым после отправки товара</li>
            <li>Покупатель должен быть дееспособным физическим или юридическим лицом</li>
          </ul>
        </section>

        {/* Раздел 3 */}
        <section class="space-y-3">
          <h2 class="text-2xl md:text-3xl font-bold text-gray-900">3. Товары и цены</h2>
          <ul class="space-y-2 ml-6 list-disc list-outside">
            <li>Все цены указаны в российских рублях (RUB)</li>
            <li>Цены могут быть изменены без предварительного уведомления</li>
            <li>Цена товара фиксируется в момент подтверждения заказа</li>
            <li>На скидки действуют условия, указанные на сайте</li>
          </ul>
        </section>

        {/* Раздел 4 */}
        <section class="space-y-3">
          <h2 class="text-2xl md:text-3xl font-bold text-gray-900">4. Размещение заказа</h2>
          <p class="text-base">Для размещения заказа необходимо:</p>
          <ol class="space-y-2 ml-6 list-decimal list-outside">
            <li>Выбрать товар и нажать «Добавить в корзину»</li>
            <li>Оформить заказ, указав контактную информацию</li>
            <li>Выбрать способ доставки и оплаты</li>
            <li>Подтвердить заказ нажатием кнопки «Заказать»</li>
            <li>Получить подтверждение заказа по email</li>
          </ol>
        </section>

        {/* Раздел 5 */}
        <section class="space-y-3">
          <h2 class="text-2xl md:text-3xl font-bold text-gray-900">5. Доставка</h2>
          <ul class="space-y-2 ml-6 list-disc list-outside">
            <li>Доставка осуществляется в соответствии с выбранным вариантом</li>
            <li>Сроки доставки указаны ориентировочно и не являются гарантией</li>
            <li>Риск случайной гибели или повреждения товара переходит покупателю после его получения</li>
            <li>Претензии по качеству доставки принимаются в течение 3 дней</li>
          </ul>
        </section>

        {/* Раздел 6 */}
        <section class="space-y-3">
          <h2 class="text-2xl md:text-3xl font-bold text-gray-900">6. Оплата</h2>
          <ul class="space-y-2 ml-6 list-disc list-outside">
            <li>Оплата может производиться одним из способов, указанных на сайте</li>
            <li>Для юридических лиц доступна оплата по счёту</li>
            <li>Товар отправляется только после получения платежа</li>
            <li>При возврате платежа расходы несёт покупатель</li>
          </ul>
        </section>

        {/* Раздел 7 */}
        <section class="space-y-3">
          <h2 class="text-2xl md:text-3xl font-bold text-gray-900">7. Возврат и обмен</h2>
          <ul class="space-y-2 ml-6 list-disc list-outside">
            <li>Возврат товара допускается в течение 30 дней</li>
            <li>Товар должен быть не использован и в оригинальной упаковке</li>
            <li>Подробные условия возврата указаны в разделе «Гарантия и возврат»</li>
            <li>Возврат денег производится в течение 5—7 дней после получения товара</li>
          </ul>
        </section>

        {/* Раздел 8 */}
        <section class="space-y-3">
          <h2 class="text-2xl md:text-3xl font-bold text-gray-900">8. Гарантия</h2>
          <ul class="space-y-2 ml-6 list-disc list-outside">
            <li>Гарантийное обслуживание предоставляется в соответствии с условиями гарантии</li>
            <li>Гарантия не распространяется на повреждения вследствие неправильного использования</li>
            <li>Срок гарантии указан в паспорте товара и на сайте</li>
          </ul>
        </section>

        {/* Раздел 9 */}
        <section class="space-y-3">
          <h2 class="text-2xl md:text-3xl font-bold text-gray-900">9. Ограничение ответственности</h2>
          <p class="text-base">Продавец не несет ответственность за:</p>
          <ul class="space-y-2 ml-6 list-disc list-outside">
            <li>Убытки, возникшие вследствие неправильного использования товара</li>
            <li>Косвенные убытки и упущенную прибыль</li>
            <li>Задержку доставки по причинам, не зависящим от Продавца</li>
            <li>Потерю или повреждение товара при доставке курьерской компанией</li>
          </ul>
        </section>

        {/* Раздел 10 */}
        <section class="space-y-3">
          <h2 class="text-2xl md:text-3xl font-bold text-gray-900">10. Конфиденциальность и защита данных</h2>
          <p class="text-base">
            Обработка персональных данных осуществляется в соответствии с политикой конфиденциальности и Федеральным законом от 27.07.2006 № 152-ФЗ «О персональных данных».
          </p>
        </section>

        {/* Раздел 11 */}
        <section class="space-y-3">
          <h2 class="text-2xl md:text-3xl font-bold text-gray-900">11. Спорные вопросы</h2>
          <ul class="space-y-2 ml-6 list-disc list-outside">
            <li>Споры разрешаются в порядке досудебного разбирательства</li>
            <li>В случае неразрешения спора — в судебном порядке</li>
            <li>Применяется законодательство Российской Федерации</li>
          </ul>
        </section>

        {/* Раздел 12 */}
        <section class="space-y-3 pb-8 border-b border-gray-200">
          <h2 class="text-2xl md:text-3xl font-bold text-gray-900">12. Контакты</h2>
          <p class="text-base">По вопросам заказов и условий продажи свяжитесь с нами:</p>
          <ul class="space-y-2 ml-6 list-disc list-outside">
            <li><strong>Email:</strong> <a href={`mailto:${COMPANY_INFO.email}`} class="text-primary-600 hover:text-primary-700 transition">{COMPANY_INFO.email}</a></li>
            <li><strong>Телефон:</strong> <a href={`tel:${COMPANY_INFO.phoneMain.replace(/\D/g, '')}`} class="text-primary-600 hover:text-primary-700 transition">{COMPANY_INFO.phoneMain}</a></li>
            <li><strong>Адрес:</strong> {COMPANY_INFO.legalAddress}</li>
          </ul>
        </section>

        {/* Цифровая подпись */}
        <div class="pt-8 text-center text-sm text-gray-500">
          <p>Данные условия применяются к клиентам SARPRO, совершающим покупки онлайн. Последнее изменение: апрель 2026 г.</p>
        </div>
      </div>
    </div>
  </Container>
</BaseLayout>
