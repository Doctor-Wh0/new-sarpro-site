---
// src/pages/404.astro
// Страница ошибки 404

import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumb from '@/components/common/Breadcrumb.astro';
import Container from '@/components/layout/Container.astro';
---

<BaseLayout
  title="Страница не найдена — SARPRO"
  description="Страница не найдена. Вернитесь на главную или перейдите в каталог пломб и пломбировочных средств SARPRO."
  robots="noindex, follow"
>
  <Container size="base">
    <Breadcrumb items={[
      { label: 'Главная', url: '/' },
      { label: 'Страница не найдена', url: '/404' }
    ]} />

    <div class="py-16 md:py-24 text-center">
      <p class="text-8xl md:text-9xl font-bold text-primary-600 mb-4">404</p>
      <h1 class="text-3xl md:text-4xl font-bold mb-6">Страница не найдена</h1>
      <p class="text-lg text-gray-700 mb-10 max-w-xl mx-auto">
        К сожалению, запрашиваемая страница была перемещена, удалена или никогда не существовала.
        Проверьте адрес в строке браузера или воспользуйтесь ссылками ниже.
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/"
          class="px-6 py-3 rounded-full bg-primary-600 text-white font-semibold hover:bg-primary-700 transition-all duration-200"
        >
          На главную
        </a>
        <a
          href="/catalog"
          class="px-6 py-3 rounded-full border-2 border-primary-600 text-primary-700 font-semibold hover:bg-primary-600 hover:text-white transition-all duration-200"
        >
          Перейти в каталог
        </a>
        <a
          href="/contacts"
          class="px-6 py-3 rounded-full text-gray-600 font-semibold hover:text-primary-700 transition-all duration-200"
        >
          Связаться с нами
        </a>
      </div>
    </div>
  </Container>
</BaseLayout>
