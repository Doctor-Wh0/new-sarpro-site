---
// src/pages/categories/[slug].astro
// Динамическая страница категории

import type { GetStaticPaths } from 'astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumb from '@/components/common/Breadcrumb.astro';
import TrustBadges from '@/components/common/TrustBadges.astro';
import ProductCard from '@/components/product/ProductCard.astro';
import Container from '@/components/layout/Container.astro';
import { getAllCategories, getProductsByCategory, getCategoryBySlug } from '@/lib/utils';
import { generateCategorySchema } from '@/lib/schema';

export const getStaticPaths: GetStaticPaths = async () => {
  const categories = await getAllCategories();
  return categories.map(category => ({
    params: { slug: category.slug },
    props: { category }
  }));
};

interface Props {
  category: any;
}

const { category } = Astro.props;
const products = await getProductsByCategory(category.id);
const schema = generateCategorySchema(category, products, import.meta.env.SITE || 'https://saratov-pro.github.io');
---

<BaseLayout 
  title={`${category.name} — купить в SARPRO`}
  description={category.description}
  image={category.image}
  keywords={[category.name, 'купить', 'SARPRO']}
  schema={schema}
>
  <Container>
    <!-- Breadcrumb -->
    <Breadcrumb items={[
      { label: 'Главная', url: '/' },
      { label: 'Каталог', url: '/catalog' },
      { label: category.name, url: `/categories/${category.slug}` }
    ]} />

    <!-- Заголовок -->
    <div class="py-8 md:py-12 border-b border-gray-200">
      <h1 class="text-4xl md:text-5xl font-bold mb-4">{category.name}</h1>
      <p class="text-lg text-gray-600 max-w-2xl">{category.description}</p>
    </div>

    <!-- Товары -->
    <div class="py-12">
      <h2 class="text-2xl font-bold mb-8">Товары в категории ({products.length})</h2>
      
      {products.length > 0 ? (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8">
          {products.map(product => (
            <ProductCard product={product} />
          ))}
        </div>
      ) : (
        <p class="text-center text-gray-600 py-8">
          Товары в этой категории пока отсутствуют
        </p>
      )}
    </div>
  </Container>

  <TrustBadges />
</BaseLayout>
