---
// src/pages/index.astro
// Главная страница

import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumb from '@/components/common/Breadcrumb.astro';
import TrustBadges from '@/components/common/TrustBadges.astro';
import ProductCard from '@/components/product/ProductCard.astro';
import Container from '@/components/layout/Container.astro';
import { getAllCategories, getAllProducts } from '@/lib/utils';
import { COMPANY_INFO } from '@/lib/constants';

const categories = await getAllCategories();
const allProducts = await getAllProducts();
const featuredProducts = allProducts.slice(0, 6);
---

<BaseLayout 
  title="SARPRO — сейфы, пломбы и оборудование для безопасности"
  description="Официальный поставщик сейфов, пломб, ККТ и банковского оборудования. Доставка по РФ. Гарантия качества."
>
  <!-- Hero section -->
  <section class="pt-12 pb-20 md:pt-20 md:pb-32 bg-gradient-to-r from-primary-500 to-primary-600 text-white">
    <Container>
      <div class="max-w-2xl">
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold mb-6">
          Сейфы и оборудование безопасности для вашего бизнеса
        </h1>
        <p class="text-lg md:text-xl mb-8 opacity-90">
          Более 20 лет опыта в поставке надёжного оборудования для банков, компаний и госучреждений. Доставка по todas России.
        </p>
        <div class="flex flex-col sm:flex-row gap-4">
          <a 
            href="/catalog" 
            class="bg-accent-light text-white px-8 py-3 rounded-lg font-bold hover:bg-green-700 transition text-center"
          >
            Перейти в каталог
          </a>
          <a 
            href="/contacts" 
            class="border-2 border-white text-white px-8 py-3 rounded-lg font-bold hover:bg-white hover:text-primary-500 transition text-center"
          >
            Связаться с нами
          </a>
        </div>
      </div>
    </Container>
  </section>

  <!-- Категории -->
  <section class="py-16 md:py-24">
    <Container>
      <h2 class="text-3xl md:text-4xl font-bold mb-12 text-center">Основные категории</h2>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8">
        {categories.map(category => (
          <a href={`/categories/${category.slug}`} class="group">
            <div class="bg-white border border-gray-200 rounded-lg overflow-hidden hover:shadow-xl transition">
              <div class="w-full h-48 bg-neutral-light overflow-hidden">
                <img 
                  src={category.image} 
                  alt={category.name}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                />
              </div>
              <div class="p-6">
                <h3 class="text-xl font-bold mb-2 group-hover:text-primary-500 transition">
                  {category.name}
                </h3>
                <p class="text-gray-600 text-sm mb-4">
                  {category.description}
                </p>
                <span class="text-primary-500 font-semibold group-hover:gap-1">
                  Подробнее →
                </span>
              </div>
            </div>
          </a>
        ))}
      </div>
    </Container>
  </section>

  <!-- Рекомендуемые товары -->
  <section class="py-16 md:py-24 bg-neutral-light">
    <Container>
      <h2 class="text-3xl md:text-4xl font-bold mb-4 text-center">Популярные товары</h2>
      <p class="text-center text-gray-600 mb-12 max-w-2xl mx-auto">
        Выбирайте из наших самых популярных и надёжных товаров для защиты вашего бизнеса
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8">
        {featuredProducts.map(product => (
          <ProductCard product={product} />
        ))}
      </div>

      <div class="mt-12 text-center">
        <a 
          href="/catalog"
          class="inline-block bg-primary-500 text-white px-8 py-3 rounded-lg font-bold hover:bg-primary-600 transition"
        >
          Смотреть все товары
        </a>
      </div>
    </Container>
  </section>

  <!-- Trust badges -->
  <TrustBadges />

  <!-- CTA section -->
  <section class="py-16 md:py-24 bg-primary-500 text-white">
    <Container>
      <div class="max-w-2xl mx-auto text-center">
        <h2 class="text-3xl md:text-4xl font-bold mb-6">
          Остались вопросы?
        </h2>
        <p class="text-lg mb-8 opacity-90">
          Наши специалисты помогут вам выбрать нужное оборудование и ответят на все вопросы о доставке и гарантии.
        </p>
        <a 
          href="/contacts"
          class="inline-block bg-accent-light text-white px-8 py-3 rounded-lg font-bold hover:bg-green-700 transition"
        >
          Оставить заявку
        </a>
      </div>
    </Container>
  </section>
</BaseLayout>
