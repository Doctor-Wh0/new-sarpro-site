---
// src/pages/index.astro
// Главная страница

import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumb from '@/components/common/Breadcrumb.astro';
import TrustBadges from '@/components/common/TrustBadges.astro';
import CertificationBadges from '@/components/common/CertificationBadges.astro';
import ProductCard from '@/components/product/ProductCard.astro';
import Container from '@/components/layout/Container.astro';
import { getAllCategories, getAllProducts } from '@/lib/utils';
import { COMPANY_INFO } from '@/lib/constants';

const categories = await getAllCategories();
const allProducts = await getAllProducts();
const featuredProducts = allProducts.slice(0, 6);
---

<BaseLayout 
  title="SARPRO — сейфы, пломбы и оборудование для безопасности"
  description="Официальный поставщик сейфов, пломб, ККТ и банковского оборудования. Доставка по РФ. Гарантия качества."
>
  <!-- Hero section -->
  <section class="relative pt-16 pb-24 md:pt-24 md:pb-40 bg-gradient-to-br from-blue-600 via-blue-700 to-blue-900 overflow-hidden">
    <!-- Декоративный элемент фона -->
    <div class="absolute top-0 right-0 w-96 h-96 bg-white/5 rounded-full blur-3xl"></div>
    <div class="absolute -bottom-32 -left-32 w-96 h-96 bg-white/5 rounded-full blur-3xl"></div>
    
    <Container>
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center relative z-10">
        <!-- Левая часть: Текст и CTA -->
        <div>
          <h1 class="text-5xl md:text-6xl lg:text-7xl font-bold text-white mb-6 tracking-tight leading-tight">
            Оборудование безопасности премиум-класса
          </h1>
          <p class="text-lg md:text-xl text-blue-100 mb-8 leading-relaxed">
            Более 20 лет мы поставляем надёжные сейфы, пломбы и фискальное оборудование для 5000+ компаний и банков по всей России.
          </p>
          
          <!-- Stats -->
          <div class="grid grid-cols-3 gap-4 mb-8 py-6 border-y border-white/20">
            <div>
              <p class="text-3xl md:text-4xl font-bold text-white">20+</p>
              <p class="text-sm text-blue-100 mt-1">лет опыта</p>
            </div>
            <div>
              <p class="text-3xl md:text-4xl font-bold text-white">5000+</p>
              <p class="text-sm text-blue-100 mt-1">клиентов</p>
            </div>
            <div>
              <p class="text-3xl md:text-4xl font-bold text-white">48ч</p>
              <p class="text-sm text-blue-100 mt-1">доставка РФ</p>
            </div>
          </div>
          
          <!-- CTA Buttons -->
          <div class="flex flex-col sm:flex-row gap-4 mb-8">
            <a href="/catalog"
               class="inline-block bg-amber-400 hover:bg-amber-300 text-blue-900 font-bold rounded-lg px-8 py-4 text-base shadow-lg hover:shadow-xl transition-all duration-200">
              Перейти в каталог →
            </a>
            <a href="/contacts"
               class="inline-block border-2 border-white text-white hover:bg-white/10 font-bold rounded-lg px-8 py-4 text-base transition-all duration-200">
              Свяжитесь с нами
            </a>
          </div>
          
          <!-- Trust badge -->
          <div class="flex items-center gap-2 text-blue-100 text-sm">
            <span class="text-lg">✓</span>
            <p>Все товары сертифицированы по ГОСТ и 54-ФЗ</p>
          </div>
        </div>
        
        <!-- Правая часть: Visual element (только на больших экранах) -->
        <div class="hidden lg:block">
          <div class="relative">
            <!-- Glassmorphic card с иконками сертификатов -->
            <div class="card-glassmorphism bg-white/10 backdrop-blur-md p-8 border border-white/20 rounded-2xl">
              <div class="grid grid-cols-2 gap-6">
                <div class="text-center p-4 bg-white/5 rounded-lg border border-white/10 hover:bg-white/10 transition-all">
                  <div class="text-4xl mb-2">🔐</div>
                  <p class="text-sm font-semibold text-white">Сейфы</p>
                  <p class="text-xs text-blue-200">ГОСТ 50862</p>
                </div>
                <div class="text-center p-4 bg-white/5 rounded-lg border border-white/10 hover:bg-white/10 transition-all">
                  <div class="text-4xl mb-2">🏛️</div>
                  <p class="text-sm font-semibold text-white">ФЗ-54</p>
                  <p class="text-xs text-blue-200">Кассовые аппараты</p>
                </div>
                <div class="text-center p-4 bg-white/5 rounded-lg border border-white/10 hover:bg-white/10 transition-all">
                  <div class="text-4xl mb-2">📦</div>
                  <p class="text-sm font-semibold text-white">Доставка</p>
                  <p class="text-xs text-blue-200">По всей РФ</p>
                </div>
                <div class="text-center p-4 bg-white/5 rounded-lg border border-white/10 hover:bg-white/10 transition-all">
                  <div class="text-4xl mb-2">✓</div>
                  <p class="text-sm font-semibold text-white">Гарантия</p>
                  <p class="text-xs text-blue-200">1-3 года</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- Категории -->
  <section class="py-16 md:py-24">
    <Container>
      <h2 class="text-3xl md:text-4xl font-bold mb-12 text-center">Основные категории</h2>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8">
        {categories.map(category => (
          <a href={`/categories/${category.slug}`} class="group">
            <div class="bg-white border border-gray-200 rounded-lg overflow-hidden hover:shadow-xl transition">
              <div class="w-full h-48 bg-gray-100 overflow-hidden">
                <img 
                  src={category.image} 
                  alt={category.name}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                />
              </div>
              <div class="p-6">
                <h3 class="text-xl font-bold mb-2 group-hover:text-blue-600 transition">
                  {category.name}
                </h3>
                <p class="text-gray-600 text-sm mb-4">
                  {category.description}
                </p>
                <span class="text-blue-600 font-semibold group-hover:gap-1">
                  Подробнее →
                </span>
              </div>
            </div>
          </a>
        ))}
      </div>
    </Container>
  </section>

  <!-- Рекомендуемые товары -->
  <section class="py-16 md:py-24 bg-gray-100">
    <Container>
      <h2 class="text-3xl md:text-4xl font-bold mb-4 text-center">Популярные товары</h2>
      <p class="text-center text-gray-600 mb-12 max-w-2xl mx-auto">
        Выбирайте из наших самых популярных и надёжных товаров для защиты вашего бизнеса
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8">
        {featuredProducts.map(product => (
          <ProductCard product={product} />
        ))}
      </div>

      <div class="mt-12 text-center">
        <a 
          href="/catalog"
          class="inline-block bg-blue-600 text-white hover:bg-white hover:text-blue-700 font-bold rounded-lg px-8 py-3 shadow-md hover:shadow-lg transition-all duration-200"
        >
          Смотреть все товары
        </a>
      </div>
    </Container>
  </section>

  <!-- Trust badges -->
  <TrustBadges />

  <!-- Certification badges -->
  <CertificationBadges />

  <!-- CTA section -->
  <section class="py-16 md:py-24 bg-gradient-to-r from-blue-600 to-blue-800 text-white">
    <Container>
      <div class="max-w-2xl mx-auto text-center">
        <h2 class="text-3xl md:text-4xl font-bold mb-6">
          Остались вопросы?
        </h2>
        <p class="text-lg mb-8 opacity-90 leading-relaxed">
          Наши специалисты помогут вам выбрать нужное оборудование и ответят на все вопросы о доставке и гарантии. Ответ в течение 5 минут.
        </p>
        <a 
          href="/contacts"
          class="inline-block px-8 py-4 bg-amber-400 hover:bg-amber-300 text-blue-900 font-bold rounded-lg transition-all duration-200 shadow-lg hover:shadow-xl transform hover:scale-105">
          Оставить заявку
        </a>
        
        <!-- Trust phrase -->
        <p class="text-sm opacity-75 mt-8">
          💬 Мы не передаём данные третьим лицам<br/>
          ✓ Бесплатная консультация
        </p>
      </div>
    </Container>
  </section>
</BaseLayout>
