---
// src/pages/privacy.astro
// Политика конфиденциальности

import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumb from '@/components/common/Breadcrumb.astro';
import Container from '@/components/layout/Container.astro';
import { COMPANY_INFO } from '@/lib/constants';
import { generateWebPageSchema } from '@/lib/schema';

const baseUrl = import.meta.env.SITE || 'https://saratov-pro.github.io';
const title = 'Политика конфиденциальности — SARPRO';
const description = 'Политика конфиденциальности и обработки персональных данных SARPRO.';
---

<BaseLayout 
  title={title}
  description={description}
  schema={generateWebPageSchema(title, description, `${baseUrl}/privacy`)}
>
  <Container>
    <Breadcrumb items={[
      { label: 'Главная', url: '/' },
      { label: 'Политика конфиденциальности', url: '/privacy' }
    ]} />

    <div class="py-12 md:py-16 max-w-3xl">
      <h1 class="text-4xl md:text-5xl font-bold mb-4">Политика конфиденциальности</h1>
      <p class="text-sm text-gray-600 mb-12">Последнее обновление: апрель 2026</p>

      <div class="prose prose-sm md:prose-base">
        <h2>1. Общие положения</h2>
        <p>
          {COMPANY_INFO.name} (далее — «Сервис», «Компания», «мы») соблюдает требования Федерального закона от 27 июля 2006 г. № 152-ФЗ «О защите персональных данных» (далее — ФЗ об ОПД) и иных требований российского законодательства в области защиты персональных данных.
        </p>
        <p>
          Данная политика объясняет, как мы собираем, используем, защищаем и раскрываем информацию о вас при использовании нашего веб-сайта и услуг.
        </p>

        <h2>2. Информация, которую мы собираем</h2>
        <p>Мы собираем информацию, которую вы предоставляете нам непосредственно:</p>
        <ul>
          <li>Имя и контактная информация (email, телефон)</li>
          <li>Адрес доставки и учреждение</li>
          <li>История запросов и покупок</li>
          <li>Информация о предпочтениях товаров</li>
          <li>Иная информация, предоставленная в формах обратной связи</li>
        </ul>

        <h2>3. Как мы используем информацию</h2>
        <ul>
          <li>Обработка и выполнение заказов</li>
          <li>Доставка товаров и обслуживание</li>
          <li>Отправка уведомлений и информации о заказах</li>
          <li>Улучшение качества обслуживания</li>
          <li>Информирование о новостях и предложениях (с согласия)</li>
          <li>Защита прав и исполнение законных интересов</li>
        </ul>

        <h2>4. Защита информации</h2>
        <p>
          Мы используем технические и организационные меры для защиты персональных данных от несанкционированного доступа, изменения, раскрытия или уничтожения. Все передачи данных выполняются по защищённому каналу HTTPS.
        </p>

        <h2>5. Раскрытие информации</h2>
        <p>Мы не раскрываем ваши персональные данные третьим лицам, кроме случаев:</p>
        <ul>
          <li>Требования законодательства Российской Федерации</li>
          <li>Компании доставки (для отправки товаров)</li>
          <li>Платёжные системы (для обработки платежей)</li>
          <li>Другие поставщики услуг, работающие под договором конфиденциальности</li>
        </ul>

        <h2>6. Cookies и отслеживание</h2>
        <p>
          Мы используем cookies для улучшения вашего опыта на сайте. Вы можете отключить cookies в настройках вашего браузера, но это может повлиять на функциональность сайта.
        </p>

        <h2>7. Ваши права</h2>
        <p>Вы имеете право:</p>
        <ul>
          <li>Узнать, какая информация о вас хранится</li>
          <li>Потребовать исправление неверной информации</li>
          <li>Потребовать удаление данных (в соответствии с законодательством)</li>
          <li>Отозвать согласие на обработку данных</li>
          <li>Направить жалобу в органы защиты прав субъектов персональных данных</li>
        </ul>

        <h2>8. Изменения политики</h2>
        <p>
          Мы оставляем за собой право вносить изменения в данную политику конфиденциальности. Последние обновления будут опубликованы на этой странице.
        </p>

        <h2>9. Контакты</h2>
        <p>
          Если у вас есть вопросы о политике конфиденциальности или обработке ваших данных, свяжитесь с нами:
        </p>
        <ul>
          <li><strong>Email:</strong> {COMPANY_INFO.email}</li>
          <li><strong>Телефон:</strong> {COMPANY_INFO.phoneMain}</li>
          <li><strong>Адрес:</strong> {COMPANY_INFO.legalAddress}</li>
        </ul>
      </div>
    </div>
  </Container>
</BaseLayout>
