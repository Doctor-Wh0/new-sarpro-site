---
// src/pages/delivery.astro
// Доставка и оплата

import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumb from '@/components/common/Breadcrumb.astro';
import TrustBadges from '@/components/common/TrustBadges.astro';
import Container from '@/components/layout/Container.astro';
import { PAYMENT_METHODS, DELIVERY_METHODS } from '@/lib/constants';
---

<BaseLayout 
  title="Доставка и оплата — SARPRO"
  description="Информация о доставке товаров по России и способах оплаты."
>
  <Container>
    <Breadcrumb items={[
      { label: 'Главная', url: '/' },
      { label: 'Доставка и оплата', url: '/delivery' }
    ]} />

    <div class="py-12 md:py-16">
      <h1 class="text-4xl md:text-5xl font-bold mb-4">Доставка и оплата</h1>
      <p class="text-lg text-gray-600 mb-12">
        Удобные способы доставки и оплаты для вашего удобства
      </p>

      <!-- Доставка -->
      <div class="mb-16">
        <h2 class="text-3xl font-bold mb-8">Доставка</h2>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-8 mb-8">
          {DELIVERY_METHODS.map(method => (
            <div class="p-6 border border-gray-200 rounded-lg hover:shadow-lg transition">
              <div class="text-3xl mb-3">📦</div>
              <p class="text-gray-700">{method}</p>
            </div>
          ))}
        </div>

        <div class="bg-blue-50 border border-blue-200 rounded-lg p-8">
          <h3 class="font-bold text-lg mb-4">Сроки доставки</h3>
          <ul class="space-y-3 text-gray-700">
            <li><strong>Саратов:</strong> 1—2 дня (курьер или самовывоз)</li>
            <li><strong>Другие города РФ:</strong> 3—7 дней (CDEK, Boxberry, Почта России)</li>
            <li><strong>Крупные заказы:</strong> доставка в течение 5—10 дней</li>
          </ul>
          <p class="text-sm text-gray-600 mt-4">
            * Сроки указаны от момента отправки товара. Учитывайте время на подготовку заказа (1—2 дня).
          </p>
        </div>

        <div class="mt-8 bg-green-50 border border-green-200 rounded-lg p-8">
          <h3 class="font-bold text-lg mb-4">Доставка крупногабаритных товаров</h3>
          <p class="text-gray-700 mb-4">
            Сейфы и крупное оборудование доставляются специализированными транспортными компаниями с возможностью монтажа и настройки на месте. Стоимость доставки рассчитывается индивидуально.
          </p>
          <p class="text-sm text-gray-600">
            Свяжитесь с нами для уточнения стоимости доставки вашего заказа.
          </p>
        </div>
      </div>

      <!-- Оплата -->
      <div>
        <h2 class="text-3xl font-bold mb-8">Способы оплаты</h2>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-8 mb-8">
          {PAYMENT_METHODS.map(method => (
            <div class="p-6 border border-gray-200 rounded-lg hover:shadow-lg transition">
              <div class="text-3xl mb-3">💳</div>
              <p class="text-gray-700">{method}</p>
            </div>
          ))}
        </div>

        <div class="bg-blue-50 border border-blue-200 rounded-lg p-8">
          <h3 class="font-bold text-lg mb-4">Условия оплаты</h3>
          <ul class="space-y-3 text-gray-700">
            <li>✓ Оплата по счёту (для юридических лиц) с отсрочкой до 30 дней</li>
            <li>✓ Оплата 50% авансом + 50% при отправке (для больших заказов)</li>
            <li>✓ Оплата при получении (для некоторых видов доставки)</li>
            <li>✓ Рассрочка платежа (в рамках программы лояльности)</li>
          </ul>
        </div>

        <div class="mt-8 bg-yellow-50 border border-yellow-200 rounded-lg p-8">
          <h3 class="font-bold text-lg mb-4">Безопасность платежей</h3>
          <p class="text-gray-700 mb-4">
            Все платежи обрабатываются защищённо. Мы используем стандарты безопасности PCI DSS и защиту от мошенничества. Ваши данные не передаются третьим лицам.
          </p>
        </div>
      </div>

      <!-- FAQ -->
      <div class="mt-16 bg-neutral-light rounded-lg p-8">
        <h2 class="text-2xl font-bold mb-6">Часто задаваемые вопросы</h2>
        
        <div class="space-y-6">
          <div>
            <h3 class="font-bold text-lg mb-2">Можно ли вернуть товар?</h3>
            <p class="text-gray-700">
              Да, в течение 30 дней с момента получения товара, если он не был использован и находится в оригинальной упаковке.
            </p>
          </div>

          <div>
            <h3 class="font-bold text-lg mb-2">Как узнать стоимость доставки?</h3>
            <p class="text-gray-700">
              Свяжитесь с нами по телефону или заполните форму на странице контактов. Мы пришлём смету в течение 24 часов.
            </p>
          </div>

          <div>
            <h3 class="font-bold text-lg mb-2">Нужна ли доп. услуга — монтаж и настройка?</h3>
            <p class="text-gray-700">
              Да, мы предоставляем услугу монтажа, настройки и обучения. Стоимость зависит от типа оборудования.
            </p>
          </div>

          <div>
            <h3 class="font-bold text-lg mb-2">Есть ли скидки на оптовые заказы?</h3>
            <p class="text-gray-700">
              Да! При заказе от 10 товаров предусмотрены скидки. Свяжитесь с нами для уточнения условий.
            </p>
          </div>
        </div>
      </div>
    </div>
  </Container>

  <TrustBadges />
</BaseLayout>
