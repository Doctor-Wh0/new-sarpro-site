---
// src/components/common/CertificationBadges.astro
// Бейджи сертификации ГОСТ, ФЗ-54, ISO
---

<section class="py-12 md:py-16 bg-white">
  <div class="container max-w-7xl mx-auto px-4 md:px-6 lg:px-8">
    <p class="text-center text-gray-600 text-sm uppercase tracking-wide font-semibold mb-8">
      Сертификация и соответствие стандартам
    </p>
    
    <div class="flex flex-wrap justify-center items-center gap-6 md:gap-12">
      <!-- GOST -->
      <div class="group text-center">
        <div class="inline-block p-4 bg-primary-50 rounded-lg border-2 border-primary-200 
                    group-hover:border-primary-600 group-hover:shadow-lg transition-all">
          <p class="text-2xl font-bold text-primary-600 mb-1">ГОСТ</p>
          <p class="text-xs text-gray-600 group-hover:text-gray-900 transition-colors">
            ГОСТ 50862-2005
          </p>
        </div>
      </div>
      
      <!-- FZ-54 -->
      <div class="group text-center">
        <div class="inline-block p-4 bg-green-50 rounded-lg border-2 border-green-200 
                    group-hover:border-green-600 group-hover:shadow-lg transition-all">
          <p class="text-2xl font-bold text-green-600 mb-1">ФЗ-54</p>
          <p class="text-xs text-gray-600 group-hover:text-gray-900 transition-colors">
            Фискальное оборудование
          </p>
        </div>
      </div>
      
      <!-- ISO -->
      <div class="group text-center">
        <div class="inline-block p-4 bg-indigo-50 rounded-lg border-2 border-indigo-200 
                    group-hover:border-indigo-600 group-hover:shadow-lg transition-all">
          <p class="text-2xl font-bold text-indigo-600 mb-1">ISO</p>
          <p class="text-xs text-gray-600 group-hover:text-gray-900 transition-colors">
            Международные стандарты
          </p>
        </div>
      </div>
      
      <!-- RF -->
      <div class="group text-center">
        <div class="inline-block p-4 bg-cta-50 rounded-lg border-2 border-cta-200 
                    group-hover:border-cta-600 group-hover:shadow-lg transition-all">
          <p class="text-2xl font-bold text-cta-600 mb-1">РФ</p>
          <p class="text-xs text-gray-600 group-hover:text-gray-900 transition-colors">
            Сертификат РФ
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
