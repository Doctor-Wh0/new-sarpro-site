---
// Форма контакта
---

<form id="contact-form" class="max-w-2xl mx-auto space-y-6">
  <!-- Усиление trust -->
  <div class="mb-8 p-4 bg-blue-50 border-l-4 border-blue-600 rounded-r">
    <p class="text-sm text-blue-900 font-semibold">
      ✓ Мы на связи (пн-пт, 09:00-18:00)
    </p>
  </div>

  <div id="success-message" role="status" class="hidden p-4 bg-green-50 border border-green-200 rounded-lg text-green-800">
    ✓ Спасибо! Ваше сообщение отправлено. Мы свяжемся с вами в ближайшее время.
  </div>

  <div id="error-message" role="alert" class="hidden p-4 bg-red-50 border border-red-200 rounded-lg text-red-800"></div>

  <!-- Name field -->
  <div>
    <label for="name" class="block text-sm font-medium text-gray-900 mb-2">
      Ваше имя *
    </label>
    <input
      type="text"
      id="name"
      name="name"
      required
      minlength="2"
      maxlength="100"
      class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-600 focus:border-transparent transition"
      placeholder="Введите ваше имя"
    />
  </div>

  <!-- Email field -->
  <div>
    <label for="email" class="block text-sm font-medium text-gray-900 mb-2">
      Email *
    </label>
    <input
      type="email"
      id="email"
      name="email"
      required
      autocomplete="email"
      spellcheck="false"
      class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-600 focus:border-transparent transition"
      placeholder="example@email.com"
    />
  </div>

  <!-- Phone field -->
  <div>
    <label for="phone" class="block text-sm font-medium text-gray-900 mb-2">
      Телефон *
    </label>
    <input
      type="tel"
      id="phone"
      name="phone"
      required
      class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-600 focus:border-transparent transition"
      placeholder="+7 (999) 123-45-67"
    />
  </div>

  <!-- City field -->
  <div>
    <label for="city" class="block text-sm font-medium text-gray-900 mb-2">
      Город / регион
    </label>
    <input
      type="text"
      id="city"
      name="city"
      class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-600 focus:border-transparent transition"
      placeholder="Саратов"
    />
  </div>

  <!-- Message field -->
  <div>
    <label for="message" class="block text-sm font-medium text-gray-900 mb-2">
      Сообщение *
    </label>
    <textarea
      id="message"
      name="message"
      required
      minlength="5"
      maxlength="5000"
      rows="4"
      class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-600 focus:border-transparent transition resize-y"
      placeholder="Опишите вашу заявку..."
    ></textarea>
  </div>

  <!-- Honeypot fields (hidden from users) -->
  <input
    type="text"
    name="website"
    style="display: none"
    tabindex="-1"
    autocomplete="off"
  />
  <input
    type="text"
    name="faxNumber"
    style="display: none"
    tabindex="-1"
    autocomplete="off"
  />

  <!-- Accept terms checkbox -->
  <div class="flex items-start gap-3">
    <input
      type="checkbox"
      id="acceptTerms"
      name="acceptTerms"
      required
      class="w-5 h-5 mt-1"
    />
    <label for="acceptTerms" class="text-sm text-gray-700">
      Я согласен на обработку персональных данных и получение информации от SARPRO
      <span class="text-red-500">*</span>
    </label>
  </div>

  <!-- Submit button -->
  <button
    type="submit"
    class="w-full py-4 px-6 bg-gradient-to-r from-blue-600 to-blue-700 
           hover:from-blue-700 hover:to-blue-800 text-white font-bold text-lg
            rounded-lg shadow-lg hover:shadow-xl transition-[background-image,box-shadow] duration-200
           disabled:opacity-50 disabled:cursor-not-allowed">
    Отправить заявку
  </button>

  <p class="text-xs text-gray-500 text-center">
    Мы никогда не передаём ваши данные третьим лицам
  </p>
</form>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const successMessage = document.getElementById('success-message');
  const errorMessage = document.getElementById('error-message');

  if (form) {
    const startTime = Date.now();

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      errorMessage!.classList.add('hidden');

      // Honeypot защита
      const website = (form.querySelector('input[name="website"]') as HTMLInputElement)?.value;
      const faxNumber = (form.querySelector('input[name="faxNumber"]') as HTMLInputElement)?.value;
      
      if (website || faxNumber) {
        successMessage!.classList.remove('hidden');
        setTimeout(() => successMessage!.classList.add('hidden'), 3000);
        return;
      }

      // Проверка минимального времени заполнения (3 секунды)
      const fillTime = (Date.now() - startTime) / 1000;
      if (fillTime < 3) {
        errorMessage!.textContent = '⚠ Пожалуйста, внимательнее заполните форму';
        errorMessage!.classList.remove('hidden');
        return;
      }

      // Валидация полей
      const formData = new FormData(form);
      const name = formData.get('name') as string;
      const email = formData.get('email') as string;
      const phone = formData.get('phone') as string;
      const message = formData.get('message') as string;
      const acceptTerms = formData.get('acceptTerms');

      if (!name || name.length < 2) {
        errorMessage!.textContent = '⚠ Укажите корректное имя';
        errorMessage!.classList.remove('hidden');
        return;
      }

      if (!email || !email.includes('@')) {
        errorMessage!.textContent = '⚠ Укажите корректный email';
        errorMessage!.classList.remove('hidden');
        return;
      }

      if (!phone || phone.replace(/\D/g, '').length < 10) {
        errorMessage!.textContent = '⚠ Укажите корректный номер телефона';
        errorMessage!.classList.remove('hidden');
        return;
      }

      if (!message || message.length < 5) {
        errorMessage!.textContent = '⚠ Сообщение должно быть не менее 5 символов';
        errorMessage!.classList.remove('hidden');
        return;
      }

      if (!acceptTerms) {
        errorMessage!.textContent = '⚠ Согласитесь на обработку персональных данных';
        errorMessage!.classList.remove('hidden');
        return;
      }

      // Отправка формы через mailto (статический сайт без сервера)
      const city = (formData.get('city') as string) || '';
      const subject = `Заявка с сайта: ${name}`;
      const body = [
        `Имя: ${name}`,
        `Email: ${email}`,
        `Телефон: ${phone}`,
        city ? `Город: ${city}` : '',
        '',
        message
      ].filter(Boolean).join('\n');

      window.location.href = `mailto:info@sarpro.ru?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;

      successMessage!.textContent = '✓ Открываем почтовый клиент. Если письмо не открылось автоматически, напишите нам на info@sarpro.ru.';
      successMessage!.classList.remove('hidden');
      form.reset();
      setTimeout(() => successMessage!.classList.add('hidden'), 8000);
    });
  }
</script>
