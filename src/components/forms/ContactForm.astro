---
// Формa контакта
---

<form action="/api/submit-contact" method="POST" class="space-y-6">
  <!-- Name field -->
  <div>
    <label for="name" class="block text-sm font-medium text-neutral-dark mb-2">
      Ваше имя *
    </label>
    <input
      type="text"
      id="name"
      name="name"
      required
      minlength="2"
      maxlength="100"
      class="w-full px-4 py-2 border border-neutral-light rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent transition"
      placeholder="Введите ваше имя"
    />
  </div>

  <!-- Email field -->
  <div>
    <label for="email" class="block text-sm font-medium text-neutral-dark mb-2">
      Email *
    </label>
    <input
      type="email"
      id="email"
      name="email"
      required
      class="w-full px-4 py-2 border border-neutral-light rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent transition"
      placeholder="example@email.com"
    />
  </div>

  <!-- Phone field -->
  <div>
    <label for="phone" class="block text-sm font-medium text-neutral-dark mb-2">
      Телефон *
    </label>
    <input
      type="tel"
      id="phone"
      name="phone"
      required
      pattern="[+]?7\d{10}"
      class="w-full px-4 py-2 border border-neutral-light rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent transition"
      placeholder="+7 (999) 123-45-67"
    />
  </div>

  <!-- Message field -->
  <div>
    <label for="message" class="block text-sm font-medium text-neutral-dark mb-2">
      Сообщение *
    </label>
    <textarea
      id="message"
      name="message"
      required
      minlength="5"
      maxlength="5000"
      rows="4"
      class="w-full px-4 py-2 border border-neutral-light rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent transition resize-none"
      placeholder="Опишите вашу заявку..."
    ></textarea>
  </div>

  <!-- Honeypot fields (hidden from users) -->
  <input
    type="text"
    name="website"
    style="display: none"
    tabindex="-1"
    autocomplete="off"
  />
  <input
    type="text"
    name="faxNumber"
    style="display: none"
    tabindex="-1"
    autocomplete="off"
  />

  <!-- Submit button -->
  <button
    type="submit"
    class="w-full bg-primary-500 hover:bg-primary-600 text-white font-semibold py-3 px-6 rounded-lg transition duration-200 ease-in-out transform hover:scale-105"
  >
    Отправить заявку
  </button>

  <p class="text-xs text-gray-500 text-center">
    Мы никогда не передаём ваши данные третьим лицам
  </p>
</form>

<script>
  // Простая защита: не отправлять форму, если она заполнена слишком быстро
  const forms = document.querySelectorAll('form[action="/api/submit-contact"]');
  forms.forEach(form => {
    const startTime = Date.now();
    
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      // Проверка минимального времени заполнения (3 секунды)
      const fillTime = Date.now() - startTime;
      if (fillTime < 3000) {
        console.warn('Form filled too quickly');
        return;
      }

      // Отправка формы
      const formData = new FormData(form);
      const data = Object.fromEntries(formData);

      try {
        const response = await fetch('/api/submit-contact', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify(data),
        });

        if (response.ok) {
          // Успешная отправка
          alert('Спасибо! Мы получили вашу заявку.');
          form.reset();
          // Перенаправление на страницу благодарности (опционально)
          // window.location.href = '/thank-you';
        } else {
          const error = await response.json();
          alert(`Ошибка: ${error.error || 'Не удалось отправить заявку'}`);
        }
      } catch (error) {
        console.error('Form submission error:', error);
        alert('Ошибка при отправке. Попробуйте позже.');
      }
    });
  });
</script>
