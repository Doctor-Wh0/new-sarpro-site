---
// src/components/product/ProductSpecs.astro
// Таблица технических характеристик

import type { ProductSpec } from '@/types';

interface Props {
  specs: ProductSpec;
}

const { specs } = Astro.props;

// Красивые названия характеристик
const specNames: Record<string, string> = {
  width: 'Ширина',
  depth: 'Глубина',
  height: 'Высота',
  weight: 'Вес',
  material: 'Материал',
  lockType: 'Тип замка',
  certification: 'Сертификация',
  fireSafety: 'Огнестойкость',
  ventilation: 'Вентиляция',
  type: 'Тип',
  indicator: 'Индикатор',
  color: 'Цвет',
  quantity: 'Количество',
  diameter: 'Диаметр',
  length: 'Длина',
  tensileStrength: 'Прочность',
  compatibility: 'Совместимость',
  interface: 'Интерфейс',
  display: 'Дисплей',
  paperWidth: 'Ширина бумаги',
  printSpeed: 'Скорость печати',
  compliance: 'Соответствие стандартам',
  doors: 'Количество дверей',
  locks: 'Замки',
  size: 'Размер',
  components: 'Количество компонентов',
  marking: 'Маркировка',
  logo: 'Нанесение логотипа',
  temperature: 'Температура установки/использования',
  anchors: 'Якоря-фиксаторы',
  installation: 'Установка',
  packaging: 'Упаковка',
  branding: 'Брендирование',
  markingMethod: 'Метод маркировки',
  totalLength: 'Общая длина',
  workingLength: 'Рабочая длина',
  tapeWidth: 'Ширина ленты',
  unit: 'Единица измерения',
  gost: 'Соответствует нормативным документам',
  tu: 'Соответствует ТУ',
  application: 'Применение',
};
---

<section class="py-8 md:py-12 border-t border-gray-200">
  <h2 class="text-2xl md:text-3xl font-bold mb-6">Технические характеристики</h2>

  <div class="overflow-x-auto">
    <table class="w-full">
      <tbody>
        {Object.entries(specs).map(([key, value]) => {
          const displayName = specNames[key] || key;
          return (
            <tr class="border-b border-gray-200 hover:bg-gray-100 transition">
              <td class="py-4 px-4 font-semibold text-gray-800 md:w-1/3">
                {displayName}
              </td>
              <td class="py-4 px-4 text-gray-700">
                {value}
              </td>
            </tr>
          );
        })}
      </tbody>
    </table>
  </div>
</section>
